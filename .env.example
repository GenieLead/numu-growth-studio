# Database (Neon PostgreSQL via Vercel Marketplace)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-32-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# App Encryption (for OpenRouter key storage)
APP_ENCRYPTION_KEY="generate-a-64-char-hex-string"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=""

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Dev-only OpenRouter key for local testing
# Production should use each user's encrypted BYOK key
DEV_OPENROUTER_API_KEY=""
